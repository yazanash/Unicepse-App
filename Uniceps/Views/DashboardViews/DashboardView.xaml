<UserControl x:Class="Uniceps.Views.DashboardViews.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Uniceps.Views.DashboardViews"
             mc:Ignorable="d" 
             FontFamily="Segoe UI"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Background}">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="400"/>
                <RowDefinition Height="400"/>
                <RowDefinition Height="400"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="0,0,0,20">
                <Border Width="180" Height="100" Style="{DynamicResource CardBorderStyle}" Margin="0,0,15,15">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إيرادات اليوم" Foreground="{DynamicResource Brush.Foreground}" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TodayRevenue, StringFormat={}{0:N0}}" Foreground="#2ECC71" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Width="180" Height="100" Style="{DynamicResource CardBorderStyle}" Margin="0,0,15,15">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="مصاريف اليوم" Foreground="{DynamicResource Brush.Foreground}" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TodayExpenses, StringFormat={}{0:N0}}" Foreground="#E74C3C" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="180" Height="100" Style="{DynamicResource CardBorderStyle}" Margin="0,0,15,15">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="مدفوعات اليوم" Foreground="{DynamicResource Brush.Foreground}" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TodayCredits, StringFormat={}{0:N0}}" Foreground="#E74C3C" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Width="180" Height="100" Style="{DynamicResource CardBorderStyle}" Margin="0,0,15,15">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="المتواجدون حالياً" Foreground="{DynamicResource Brush.Foreground}" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentPresentPlayers}" Foreground="#3498DB" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Width="150" Height="100" Style="{DynamicResource CardBorderStyle}" Margin="0,0,15,15">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="الموظفون" Foreground="{DynamicResource Brush.Foreground}" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StaffCount}" Foreground="#F39C12" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Width="150" Height="100" Style="{DynamicResource CardBorderStyle}" Margin="0,0,15,15">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="المدربون" Foreground="{DynamicResource Brush.Foreground}" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TrainersCount}" Foreground="#9B59B6" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Margin="0,0,10,0" Height="300">
                    <Grid Margin="15">
                        <TextBlock Text="توزيع المشتركين (جنس)" Foreground="{DynamicResource Brush.Foreground}" FontWeight="SemiBold" VerticalAlignment="Top"/>
                        <lvc:PieChart Series="{Binding GenderSeries}" FlowDirection="LeftToRight" Margin="0,25,0,0" LegendPosition="Bottom"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Margin="10,0,0,0" Height="300">
                    <Grid Margin="15">
                        <TextBlock Text="الرياضات الأكثر طلباً" Foreground="{DynamicResource Brush.Foreground}" FontWeight="SemiBold" VerticalAlignment="Top"/>
                        <lvc:PieChart Series="{Binding SportPopularitySeries}" FlowDirection="LeftToRight" Margin="0,25,0,0" LegendPosition="Bottom"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,20">
                <Grid Margin="15">
                    <TextBlock Text="ساعات الذروة (متوسط أسبوعي - ذكر/أنثى)" Foreground="{DynamicResource Brush.Foreground}" FontWeight="SemiBold" VerticalAlignment="Top"/>
                    <lvc:CartesianChart Series="{Binding PeakHoursSeries}" 
                    XAxes="{Binding XAxesPeak}" 
                    YAxes="{Binding YAxesInteger}"
                    LegendPosition="Right"
                    TooltipPosition="Top" 
                    FlowDirection="LeftToRight"
                    Margin="0,30,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Row="3" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,20">
                <Grid Margin="15">
                    <TextBlock Text="إحصائية الحضور خلال أيام الأسبوع (ذكر/أنثى)" Foreground="{DynamicResource Brush.Foreground}" FontWeight="SemiBold" VerticalAlignment="Top"/>
                    <lvc:CartesianChart Series="{Binding WeeklyDaysSeries}" 
                                    XAxes="{Binding XAxesDays}" 
                                    YAxes="{Binding YAxesInteger}"
                                    LegendPosition="Right"
                                    TooltipPosition="Top" 
                                    FlowDirection="LeftToRight"
                                    Margin="0,30,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Row="4" Style="{DynamicResource CardBorderStyle}">
                <Grid Margin="15">
                    <TextBlock Text="التدفق المالي (6 أشهر)" Foreground="{DynamicResource Brush.Foreground}" FontWeight="SemiBold" VerticalAlignment="Top"/>
                    <lvc:CartesianChart Series="{Binding FinancialSeries}" FlowDirection="LeftToRight" XAxes="{Binding XAxesFinancial}" LegendPosition="Bottom" Margin="0,30,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

<Window x:Class="Uniceps.Views.SportViews.SportSubscriptionsWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Uniceps.Views.SportViews"
        mc:Ignorable="d"
          xmlns:cs="clr-namespace:Uniceps.Components"
  xmlns:Comp="clr-namespace:Uniceps.utlis.Components"
     xmlns:custom="clr-namespace:LoadingSpinnerControl;assembly=LoadingSpinnerControl"
    xmlns:converters="clr-namespace:Uniceps.utlis.Converters"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
  FlowDirection="RightToLeft"
        Background="{DynamicResource Brush.Background}"
        Title="اشتراكات الرياضات" Height="450" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibalityConverter x:Key="InverseBooleanToVisibalityConverter"/>
        <converters:NumberFormatConverter x:Key="covNum"/>
        <converters:EnumDisplayNameConverter x:Key="EnumToText"/>
    </Window.Resources>

    <Border  Grid.Row="1" Padding="10" Grid.Column="0" Grid.ColumnSpan="3" >

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border>
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="5" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="الاشتراكات" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10" Foreground="{DynamicResource Brush.Foreground}" FontSize="18" DockPanel.Dock="Top"/>

                    <ComboBox Style="{DynamicResource ComboBoxStyle1}" 
ItemsSource="{Binding SportsList,UpdateSourceTrigger=PropertyChanged}"
SelectedItem="{Binding SelectedSport,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
ItemContainerStyle="{DynamicResource ComboBoxItemContainerStyle1}"
       Tag=" الرياضة :" Grid.Column="1" Margin="5 0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SportName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Style="{DynamicResource ComboBoxStyle1}" 
ItemsSource="{Binding TrainersList,UpdateSourceTrigger=PropertyChanged}"
SelectedItem="{Binding SelectedTrainer,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
ItemContainerStyle="{DynamicResource ComboBoxItemContainerStyle1}"
       Tag=" المدرب :" Grid.Column="2"  Margin="5 0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TrainerName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Grid.Column="3" >
                        <TextBlock Text="التاريخ" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource Brush.Foreground}"/>
                        <DatePicker VerticalAlignment="Center" SelectedDate="{Binding Date,UpdateSourceTrigger=PropertyChanged}" Margin="10 0"/>
                    </StackPanel>
                    <Button Grid.Column="4"  Margin="10 0" Command="{Binding ClearFiltersCommand}"  FlowDirection="LeftToRight"  Style="{StaticResource IconBtn}" HorizontalAlignment="Right">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="مسح الفلترة" />
                            <Icon:PackIconMaterial Kind="FilterOff"
Width="11"
Height="11"
Margin="8 0 0 1"
VerticalAlignment="Center"/>
                        </StackPanel>

                    </Button>
                </Grid>
            </Border>
            <Border Grid.Row="1" Style="{DynamicResource StaticCardBorderStyle}">


                <Grid  Grid.Row="1">
                    <custom:LoadingSpinner
             IsLoading="{Binding IsLoading}"
             Diameter="100" Thickness="3" Color="{DynamicResource Brush.Primary}" />
                    <Grid Visibility="{Binding IsLoading ,Converter={StaticResource InverseBooleanToVisibalityConverter}}">

                        <TextBlock Text="{Binding ErrorMessage}" HorizontalAlignment="Left" Visibility="{Binding HasErrorMessage , Converter={StaticResource BoolToVis}}" Foreground="Red" Grid.Column="2" Margin="140,0,0,0"/>

                        <DataGrid   Visibility="{Binding HasErrorMessage,Converter={StaticResource InverseBooleanToVisibalityConverter}}" 
                                    
                                 FlowDirection="RightToLeft" ItemsSource="{Binding SubscriptionsList}" 
                                 CanUserReorderColumns="True"
                                 x:Name="PlayerDataGrid" Style="{DynamicResource DataGridStyle1}" 
                                 CellStyle="{DynamicResource DataGridCellStyle1}" 
                                     EnableRowVirtualization="True"
    EnableColumnVirtualization="True"
    VirtualizingPanel.IsVirtualizing="True"
    VirtualizingPanel.VirtualizationMode="Recycling"
                                 ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" RowStyle="{DynamicResource DataGridRowStyle1}" Grid.ColumnSpan="3">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" IsReadOnly="True"
          Binding="{Binding Order}"
         Width="auto"
         />
                                <DataGridTemplateColumn Header="اسم اللاعب" Width="auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Margin="10 0 0 0"  FontSize="15"  Text="{Binding PlayerName}" VerticalAlignment="Center"/>
                                                <TextBlock Margin="10 0 0 0" Text="{Binding PlayerPhone,UpdateSourceTrigger=PropertyChanged}"
               Foreground="#888" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="الرياضة" Width="auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Margin="10 0 0 0"  FontSize="15"  Text="{Binding SportName}" VerticalAlignment="Center"/>
                                                <TextBlock Margin="10 0 0 0" Text="{Binding Trainer}"
                                                               Foreground="#888" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="تاريخ الاشتراك" Width="auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Margin="10 0 0 0"  FontSize="15"  Text="{Binding RollDate}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="تاريخ انتهاء الاشتراك" Width="auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Margin="10 0 0 0"  FontSize="15"  Text="{Binding EndDate}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>


                                <DataGridTemplateColumn Header="السعر" Width="auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Margin="10 0 0 0"  FontSize="15"  Text="{Binding PriceAfterOffer,Converter={StaticResource covNum}}" VerticalAlignment="Center"/>
                                                <TextBlock Margin="10 0 0 0" Text="{Binding RestValue,Converter={StaticResource covNum}}"
                                                               Foreground="#888" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="الايام المتبقية" IsReadOnly="True"
                                         Binding="{Binding RestDays}"
                                        Width="auto"
                                        />

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
            <Comp:CaptinUniForEmpty Visibility="{Binding HasData,Converter={StaticResource InverseBooleanToVisibalityConverter}}" Grid.Row="1" Title="لا يوجد اشتراكات" 
                                        Caption="لا يوجد اشتراكات مطابقة للبحث"/>
        </Grid>
    </Border>
</Window>

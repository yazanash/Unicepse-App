<UserControl x:Class="Uniceps.Views.EmployeeViews.TrainerDuesesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Uniceps.Views.EmployeeViews"
                xmlns:converters="clr-namespace:Uniceps.utlis.Converters"
                xmlns:ctrl="clr-namespace:Uniceps.utlis.Controls"
               xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vms="clr-namespace:Uniceps.ViewModels.Employee.TrainersViewModels"
             xmlns:vs="clr-namespace:Uniceps.Views.TrainerViews"
              xmlns:pvms="clr-namespace:Uniceps.ViewModels.Employee.TrainersViewModels"
             xmlns:pvs="clr-namespace:Uniceps.Views.EmployeeViews"
              xmlns:dvs="clr-namespace:Uniceps.Views.TrainerViews"
                xmlns:cvms="clr-namespace:Uniceps.ViewModels.Employee.CreditViewModels"
             xmlns:cvs="clr-namespace:Uniceps.Views.EmployeeViews.CreditViews"
             FlowDirection="RightToLeft"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibalityConverter x:Key="InverseBooleanToVisibalityConverter"/>
        <DataTemplate DataType="{x:Type vms:EmployeeAccountantPageViewModel}">
            <vs:TrainerDues/>
        </DataTemplate>
      
        <DataTemplate DataType="{x:Type cvms:CreditListViewModel}">
            <cvs:CreditsListView/>
        </DataTemplate>
    </UserControl.Resources>
    <Border >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" Grid.RowSpan="2"  Grid.Row="0"  Padding="5"  Margin="5">
                <ctrl:InfoEmpCard DockPanel.Dock="Top" DataContext="{Binding Employee,UpdateSourceTrigger=PropertyChanged}"/>
            </Border>
            <TabControl Grid.Column="0" Style="{DynamicResource ModernTabControlStyle}"
                        SelectedIndex="{Binding SelectedTabIndex, UpdateSourceTrigger=PropertyChanged}" Margin="5">

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Style="{StaticResource MenuButtonIcon}" Kind="CashMultiple"/>
                            <TextBlock  Text="الكشف" />
                        </StackPanel>
                    </TabItem.Header>
                    <vs:TrainerDues DataContext="{Binding EmployeeAccountantPageViewModel}"/>
                </TabItem>

                <TabItem >
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Style="{StaticResource MenuButtonIcon}" Kind="Dumbbell"/>
                            <TextBlock  Text="المسحوبات" />
                        </StackPanel>
                    </TabItem.Header>
                    <cvs:CreditsListView DataContext="{Binding CreditListViewModel}"/>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</UserControl>

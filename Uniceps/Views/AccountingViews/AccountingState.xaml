<UserControl x:Class="Uniceps.Views.AccountingViews.AccountingState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Uniceps.Views.AccountingViews"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:uc="clr-namespace:Uniceps.Components"
             Background="Transparent"
             xmlns:converters="clr-namespace:Uniceps.utlis.Converters" 
             xmlns:custom="clr-namespace:LoadingSpinnerControl;assembly=LoadingSpinnerControl"
             mc:Ignorable="d" 
             FlowDirection="RightToLeft"
             xmlns:vus="clr-namespace:Uniceps.utlis.Components"
              xmlns:vms="clr-namespace:Uniceps.ViewModels.Accountant"
             xmlns:views="clr-namespace:Uniceps.Views.AccountingViews"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibalityConverter x:Key="InverseBooleanToVisibalityConverter"/>
        <converters:NumberFormatConverter x:Key="convertNum"/>
    </UserControl.Resources>
    <Border>
        <Grid Grid.Column="0" Margin="5 0" Grid.RowSpan="2" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Column="0"  Grid.ColumnSpan="3" Grid.Row="0" >
                <StackPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="التاريخ" Foreground="{DynamicResource Brush.Foreground}" Margin="0 0 20 0" FontSize="16" VerticalAlignment="Center" DockPanel.Dock="Top"/>
                        <DatePicker 
                                    SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                                   />

                    </StackPanel>
            </Border>
            <TabControl  Style="{DynamicResource ModernTabControlStyle}" Grid.ColumnSpan="3" Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" FlowDirection="RightToLeft">

                <!-- تبويب الاشتراكات -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel >

                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="AccountGroup"  Foreground="{DynamicResource Brush.Primary}"  Width="25" Height="25" />
                                <TextBlock 
Text="الاشتراكات" FontWeight="Heavy" FontSize="16" HorizontalAlignment="Center"  Margin="5 0"/>
                            </StackPanel>
                          
                                <TextBlock 
       TextAlignment="Center" Text="{Binding SubscriptionsCard,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource convertNum}}" FontWeight="DemiBold" FontSize="20" />
                               
                        </StackPanel>
                    </TabItem.Header>
                    <views:SubscriptionsCardView DataContext="{Binding SubscriptionsViewModel}" />
                </TabItem>

                <!-- تبويب المدفوعات -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel >

                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="CashRefund"   Foreground="{DynamicResource Brush.Primary}" Width="25" Height="25" VerticalAlignment="Center" />
                                <TextBlock 
Text="المدفوعات" Margin="5 0"
 FontWeight="Heavy" FontSize="16"/>
                            </StackPanel>

                            <TextBlock Margin="0 0 0 10"
TextAlignment="Center" Text="{Binding CreditsCard,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource convertNum}}" FontWeight="DemiBold" FontSize="20" />
                       
                        </StackPanel>
                    </TabItem.Header>
                    <views:CreditsCardView DataContext="{Binding CreditsViewModel}" />
                </TabItem>

                <!-- تبويب الإيرادات -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel >

                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="CashPlus" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Primary}" Width="25" Height="25" />
                                <TextBlock  Margin="5 0"
Text="الايرادات" FontWeight="Heavy" FontSize="16"/>
                            </StackPanel>

                            <TextBlock Margin="0 0 0 10"
TextAlignment="Center" Text="{Binding PaymentsCard,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource convertNum}}" FontWeight="DemiBold" FontSize="20" Foreground="{DynamicResource Brush.Primary}" />
                       
                        </StackPanel>
                    </TabItem.Header>
                    <views:PaymentsCardView DataContext="{Binding PaymentsViewModel}" />
                </TabItem>

                <!-- تبويب المصاريف -->
                <TabItem >
                    <TabItem.Header>
                        <StackPanel >

                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="CashMinus" Foreground="{DynamicResource Brush.Primary}" Width="25" Height="25" VerticalAlignment="Center"/>
                                <TextBlock   Margin="5 0"
Text="المصاريف" FontWeight="Heavy" FontSize="16" />
                            </StackPanel>

                            <TextBlock Margin="0 0 0 10"
TextAlignment="Center" Text="{Binding ExpensesCard,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource convertNum}}" FontWeight="DemiBold" FontSize="20" Foreground="{DynamicResource Brush.Primary}" />
                       
                        </StackPanel>
                        
                    </TabItem.Header>
                    <views:ExpensesCardView DataContext="{Binding ExpensesViewModel}" />
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</UserControl>
 
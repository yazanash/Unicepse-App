<Window x:Class="Uniceps.Views.PlayerViews.PlayerProfileWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Uniceps.Views.PlayerViews"
        mc:Ignorable="d"
            xmlns:ctrl="clr-namespace:Uniceps.Controls"
    xmlns:cdr="clr-namespace:Uniceps.Components"
    xmlns:ctrls="clr-namespace:Uniceps.utlis.Controls"
    xmlns:comp="clr-namespace:Uniceps.utlis.Components"
       xmlns:converters="clr-namespace:Uniceps.utlis.Converters"
    xmlns:vms="clr-namespace:Uniceps.ViewModels.PlayersViewModels"
    xmlns:view="clr-namespace:Uniceps.Views.PlayerViews"
     xmlns:subsvms="clr-namespace:Uniceps.ViewModels.SubscriptionViewModel"
    xmlns:subsview="clr-namespace:Uniceps.Views.SubscriptionView"
    xmlns:payvms="clr-namespace:Uniceps.ViewModels.PaymentsViewModels"
    xmlns:payview="clr-namespace:Uniceps.Views.PaymentViews"
     xmlns:attenvms="clr-namespace:Uniceps.ViewModels.PlayersAttendenceViewModels"
    xmlns:attenview="clr-namespace:Uniceps.Views.PlayersAttendenceViews"
     xmlns:metricvms="clr-namespace:Uniceps.ViewModels.Metrics"
    xmlns:metricview="clr-namespace:Uniceps.Views.Metrics"
    xmlns:custom="clr-namespace:LoadingSpinnerControl;assembly=LoadingSpinnerControl"
    FlowDirection="RightToLeft"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Background="{DynamicResource Brush.Background}"
        WindowState="Maximized"
        Title="صفحة اللاعب" Height="450" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibalityConverter x:Key="InverseBooleanToVisibalityConverter"/>
    </Window.Resources>
    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <ctrl:InfoCard Grid.Column="1" Grid.RowSpan="2" Grid.Row="0"  DataContext="{Binding Player,UpdateSourceTrigger=PropertyChanged}"/>

            <TabControl Grid.Column="0" 
                         Style="{StaticResource ModernTabControlStyle}"
                        Background="{DynamicResource Brush.Background}"  BorderBrush="{DynamicResource Brush.Border}"  SelectedIndex="{Binding SelectedTabIndex, UpdateSourceTrigger=PropertyChanged}" Margin="5">
               
                <!-- 1. الصفحة الشخصية -->
                <TabItem >
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Style="{StaticResource MenuButtonIcon}" Kind="Account"/>
                            <TextBlock  Text="الصفحة الشخصية" />
                        </StackPanel>
                    </TabItem.Header>
                    <view:PlayerMainPage DataContext="{Binding PlayerMainPageViewModel}"/>
                </TabItem>

                <!-- 2. إضافة دفعة -->
                <TabItem >
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" >
                            <Icon:PackIconMaterial Style="{StaticResource MenuButtonIcon}" Kind="AccountCashOutline" />
                            <TextBlock Text="اضافة دفعة"  />

                        </StackPanel>
                    </TabItem.Header>
                    <payview:PaymentListView DataContext="{Binding PaymentListViewModel}"/>
                </TabItem>

                <!-- 3. القياسات -->
                <TabItem >
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Style="{StaticResource MenuButtonIcon}" Kind="ChartArc" />
                            <TextBlock Text="القياسات"  />

                        </StackPanel>
                    </TabItem.Header>
                    <metricview:MetricsCardView DataContext="{Binding MetricReportViewModel}"/>
                </TabItem>

                <!-- 4. جدول الدوام -->
                <TabItem >
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Style="{StaticResource MenuButtonIcon}" Kind="ChartBarStacked" />
                            <TextBlock Text="جدول الدوام" />

                        </StackPanel>
                    </TabItem.Header>
                    <attenview:PlayerAttendenceView DataContext="{Binding PlayerAttendenceViewModel}"/>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</Window>

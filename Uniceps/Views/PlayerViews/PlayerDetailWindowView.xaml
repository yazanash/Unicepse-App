<Window x:Class="Uniceps.Views.PlayerViews.PlayerDetailWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Uniceps.Views.PlayerViews"
        mc:Ignorable="d"
         xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
 xmlns:comp="clr-namespace:Uniceps.utlis.Components"
        xmlns:Converters="clr-namespace:Uniceps.utlis.Converters"
  FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Title="أضافة لاعب" Height="550" Width="600">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Converters:InverseBooleanToVisibalityConverter x:Key="inverseBoolToVis"/>
    </Window.Resources>


    <Border  Grid.Column="0"  Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Margin="5">
        <ScrollViewer>

            <DockPanel >
                <Grid DockPanel.Dock="Top" >
                    <TextBlock Text="معلومات اللاعب"  Foreground="{DynamicResource Brush.Foreground}" FontSize="24" />
                </Grid>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                        <TextBlock Text="اسم اللاعب" 
                                Margin="0 0 0 8" Foreground="{DynamicResource Brush.Foreground}"
                                FontSize="18"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource textBoxStyle}"/>

                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                        <TextBlock Text="رقم الهاتف" 
                                Margin="0 0 0 8" Foreground="{DynamicResource Brush.Foreground}"
                                FontSize="18"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource textBoxStyle}"/>


                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="5"  VerticalAlignment="Bottom">
                        <TextBlock Text="سنة الميلاد" 
                                Margin="0 0 0 8" Foreground="{DynamicResource Brush.Foreground}"
                                FontSize="18"/>
                        <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource textBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                        <TextBlock Text="تاريخ الاشتراك" 
                                Margin="0 0 0 8" Foreground="{DynamicResource Brush.Foreground}"
                                FontSize="18"/>
                        <!--<TextBox Text="{Binding SubscribeDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource textBoxStyle}"/>-->
                        <DatePicker 
                                 SelectedDate="{Binding SubscribeDate, UpdateSourceTrigger=PropertyChanged}"
                                />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="5">
                        <TextBlock Text="الجنس" 
                                Margin="0 0 0 8" Foreground="{DynamicResource Brush.Foreground}"
                                FontSize="18"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource RadioChoose}" IsChecked="{Binding GenderMale}" >
                                <RadioButton.Content>
                                    <!--<Border Padding="5" CornerRadius="10" BorderThickness="1" BorderBrush="#C14E00"> -->
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="FaceMan" Width="25" Height="25" />
                                        <TextBlock Text="ذكر" Margin="5 0" TextAlignment="Center" FontSize="18"
                                                        FontWeight="Bold"/>
                                    </StackPanel>
                                    <!--</Border>-->


                                </RadioButton.Content>
                            </RadioButton>
                            <RadioButton Style="{StaticResource RadioChoose}" IsChecked="True">
                                <RadioButton.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="FaceWoman"  Width="25" Height="25"  />
                                        <TextBlock Text="انثى" Margin="5 0" TextAlignment="Center" FontSize="18"
                                                        FontWeight="Bold"/>
                                    </StackPanel>

                                </RadioButton.Content>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" Margin="5">
                        <TextBlock Text="التاريخ المرضي (اختياري)" 
             Margin="0 0 0 8" Foreground="{DynamicResource Brush.Foreground}"
             FontSize="18"/>
                        <TextBox Text="{Binding MediclStatus, UpdateSourceTrigger=PropertyChanged}" MinLines="5" TextWrapping="Wrap" Style="{StaticResource textBoxStyle}"/>


                    </StackPanel>

                    <Button Command="{Binding SubmitCommand}" Style="{StaticResource FormButton}" Width="200" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" Content="حفظ" >
                        </Button>
                 
                </Grid>

            </DockPanel>
        </ScrollViewer>

    </Border>

</Window>

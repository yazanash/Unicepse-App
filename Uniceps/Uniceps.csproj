<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <SignAssembly>false</SignAssembly>
    <SelfContained>true</SelfContained>
    <Configurations>Debug;Release</Configurations>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <VersionPrefix>2.5.1</VersionPrefix>
    <Platforms>AnyCPU;x64</Platforms>
    <BuildRevision>$([System.DateTime]::Now.ToString("MMdd"))</BuildRevision>

    <Version>$(VersionPrefix).$(BuildRevision)</Version>
    <AssemblyVersion>$(VersionPrefix).$(BuildRevision)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>

    <ApplicationIcon>uni_luncher.ico</ApplicationIcon>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.Extensions.Configuration.Binder.SourceGeneration</InterceptorsNamespaces>
    <StartupObject></StartupObject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AssemblyName>Uniceps</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.*.json" CopyToPublishDirectory="Never" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="ApplyEnvConfig" BeforeTargets="Build;Publish">
    <Message Importance="high" Text="Applying $(Configuration) Config Files..." />
    <Copy Condition="Exists('appsettings.$(Configuration).json')" SourceFiles="appsettings.$(Configuration).json" DestinationFiles="appsettings.json" OverwriteReadOnlyFiles="true" />
  </Target>

  <ItemGroup>

    <Resource Include="Resources\Assets\**\*.png" />
    <Resource Include="Resources\Assets\**\*.jpg" />
    <Resource Include="Resources\Assets\**\*.jpeg" />
    <Resource Include="Resources\Assets\**\*.ico" />
    <Resource Include="Resources\Fonts\**\*.ttf" />
    <Resource Include="Resources\Fonts\**\*.otf" />
    <Resource Include="Resources\Icons\**\*.ico" />
    <Resource Include="Resources\sounds\**\*.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc5.4" />
    <PackageReference Include="LoadingSpinner.WPF" Version="1.0.0" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="SimpleModal.WPF" Version="1.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.1" />
    <PackageReference Include="System.Private.Uri" Version="4.3.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Uniceps.API\Uniceps.API.csproj" />
    <ProjectReference Include="..\Uniceps.Core\Uniceps.Core.csproj" />
    <ProjectReference Include="..\Uniceps.Entityframework\Uniceps.Entityframework.csproj" />
    <ProjectReference Include="..\Uniceps.FileSystem\Uniceps.FileSystem.csproj" />
    <ProjectReference Include="..\Uniceps.LicenseManager\Uniceps.LicenseManager.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>

  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>PublicSettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>


  <ItemGroup>
  <Reference Include="libzkfpcsharp">
    <HintPath>Libs\libzkfpcsharp.dll</HintPath>
  </Reference>
</ItemGroup>
  <Target Name="RemovePdbFilesFromPublish" AfterTargets="Publish">
    <Message Importance="high" Text="Cleaning up PDB files from publish output..." />
    <ItemGroup>
      <PdbFilesToDelete Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PdbFilesToDelete)" />
  </Target>
</Project>

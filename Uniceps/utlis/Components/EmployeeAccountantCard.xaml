<UserControl x:Class="Uniceps.utlis.Components.EmployeeAccountantCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Uniceps.utlis.Components"
             mc:Ignorable="d" 
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             FlowDirection="RightToLeft">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="4">

            <Border Style="{DynamicResource StaticCardBorderStyle}" Margin="5" Padding="12">
                <StackPanel>
                    <icon:PackIconMaterial Kind="History" Foreground="#9b59b6" Width="18" Height="18" Margin="0,0,0,8"/>
                    <TextBlock Text="رصيد سابق" FontSize="13" Foreground="#888"/>
                    <TextBlock Text="{Binding BalanceForward, StringFormat={}{0:N0}}" Foreground="{DynamicResource Brush.Foreground}" FontSize="20" FontWeight="Bold" Margin="0,4"/>
                    <Border Style="{DynamicResource CardBorderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="CalendarCheck" Width="15" Height="15" VerticalAlignment="Center" Foreground="#8e44ad" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding LastClosingDate, StringFormat='آخر ترصيد: {0:yyyy/MM/dd}'}" FontSize="10" Foreground="#8e44ad"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource StaticCardBorderStyle}" Margin="5" Padding="12">
                <StackPanel>
                    <icon:PackIconMaterial Kind="ChartPie" Foreground="{DynamicResource Brush.Primary}" Width="18" Height="18" Margin="0,0,0,8"/>
                    <TextBlock Text="إجمالي عمولة الاشتراكات" FontSize="13" Foreground="#888"/>
                    <TextBlock Text="{Binding TotalSubscriptions, StringFormat={}{0:N0}}" Foreground="{DynamicResource Brush.Foreground}" FontSize="20" FontWeight="Bold" Margin="0,4"/>

                    <Border Style="{DynamicResource CardBorderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="المستحق لتاريخ" FontSize="11" Foreground="#D35400" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding IssueDate, StringFormat={}{0:dd/MM/yyyy}}" Margin="5 0" FontSize="11" Foreground="#D35400" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalEarnedUntilNow, StringFormat={}{0:N0}}" FontSize="11" Foreground="#D35400" FontWeight="Bold" Margin="5,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding CountSubscription, StringFormat='العدد: {0}'}" FontSize="10" Foreground="#999"/>
                    </StackPanel>
                    
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource StaticCardBorderStyle}" Margin="5" Padding="12">
                <StackPanel>
                    <icon:PackIconMaterial Kind="BankTransfer" Foreground="#3498db" Width="18" Height="18" Margin="0,0,0,8"/>
                    <TextBlock Text="إجمالي الرواتب (ذمة)" FontSize="13" Foreground="#888"/>
                    <TextBlock Text="{Binding Salaries, StringFormat={}{0:N0}}" Foreground="{DynamicResource Brush.Foreground}" FontSize="20" FontWeight="Bold" Margin="0,4"/>

                    <Border Style="{DynamicResource CardBorderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="مستحق لتاريخ" FontSize="11" Foreground="#2980b9" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding IssueDate, StringFormat={}{0:dd/MM/yyyy}}" Margin="5 0" FontSize="11" Foreground="#2980b9" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalSalaryDebt , StringFormat={}{0:N0}}" FontSize="11" Foreground="#2980b9" FontWeight="Bold" Margin="5,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Salary, StringFormat='الراتب الشهري: {0:N0}'}" FontSize="10" Foreground="#999" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource StaticCardBorderStyle}" Margin="5" Padding="12">
                <StackPanel>
                    <icon:PackIconMaterial Kind="CashRemove" Foreground="#e74c3c" Width="18" Height="18" Margin="0,0,0,8"/>
                    <TextBlock Text="إجمالي المسحوبات" FontSize="13" Foreground="#888"/>
                    <TextBlock Text="{Binding Credits, StringFormat={}{0:N0}}" Foreground="#e74c3c" FontSize="20" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Text="{Binding CreditsCount, StringFormat='عدد العمليات: {0}'}" FontSize="11" Foreground="#666" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <Border Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions >
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0" Columns="2" VerticalAlignment="Center">

                    <Border Style="{DynamicResource StaticCardBorderStyle}"  Margin="5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <icon:PackIconMaterial Kind="Wallet" Foreground="#34495e" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="إجمالي رصيد المحفظة" FontSize="13" Foreground="{DynamicResource Brush.Primary}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FinalBalance, StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}"/>
                            </StackPanel>

                            <TextBlock Text="الحق المالي الكلي المسجل للمدرب" FontSize="10" Foreground="#bdc3c7" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource StaticCardBorderStyle}" Padding="5"  Margin="5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <icon:PackIconMaterial Kind="CashCheck" Foreground="#27ae60" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="المستحق للسحب حالياً" FontSize="13" Foreground="#27ae60" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ActualFairBalance, StringFormat={}{0:N0}}" FontSize="22" FontWeight="Black" Foreground="#1E8449"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="حسب تاريخ:" FontSize="10" Foreground="#27ae60" Opacity="0.8"/>
                                <TextBlock Text="{Binding IssueDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="10" Foreground="#27ae60" FontWeight="Bold" Margin="5,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </UniformGrid>
                <UniformGrid Grid.Row="1" Columns="3" HorizontalAlignment="Stretch" Margin="5,10">
                    <Button Command="{Binding AddCreditCommand}" 
             Background="#2ecc71" Foreground="White"
             Style="{StaticResource FormButton}" >
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="HandCoin" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="صرف دفعة مالية" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource FormButton}" 
                            Command="{Binding CloseTrainerAccountCommand}"
             Background="#34495e" Foreground="White" Margin="10 5">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="CheckAll" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="ترصيد الحساب" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ViewDetailCommand}" 
 Background="#3498db" Foreground="White"
 Style="{StaticResource FormButton}" 
>
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="FileDocumentEditOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="كشف حساب تفصيلي" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
              
            </Grid>
        </Border>
    </Grid>
</UserControl>

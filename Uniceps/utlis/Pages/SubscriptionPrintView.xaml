<UserControl x:Class="Uniceps.utlis.Pages.SubscriptionPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
            Width="794" Height="280" Background="White">
    <Border BorderBrush="#EEE" BorderThickness="1" Margin="5">
        <Grid Margin="10" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

          
            <Grid Grid.Column="0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding GymLogo}" Width="40" Height="40" Grid.Column="0" Margin="0,0,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding GymName}" Margin="5 0" FontSize="18" FontWeight="Bold" Grid.Column="1" Foreground="#0078D7" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding GymPhone}" Margin="5 0" FontSize="12"  Grid.Column="1" Foreground="#0078D7" VerticalAlignment="Center"/>
                            <TextBlock Text="-" Margin="5 0" FontSize="12"  Grid.Column="1" Foreground="#0078D7" VerticalAlignment="Center"/>
                            <TextBlock Text="بادارة :" Margin="5 0" FontSize="12"  Grid.Column="1" Foreground="#0078D7" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GymOwner}" Margin="5 0" FontSize="12"  Grid.Column="1" Foreground="#0078D7" VerticalAlignment="Center"/>
                        </StackPanel>
                      
                    </StackPanel>
                  
                </Grid>

                <Grid Grid.Row="1" Margin="0,10" >
                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="اسم اللاعب :" Foreground="{DynamicResource Brush.Primary}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="{Binding PlayerName}" Margin="2 0" DockPanel.Dock="Right" FontSize="12"/>
                    </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="مع المدرب :" Foreground="{DynamicResource Brush.Primary}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="{Binding Trainer}" Margin="2 0" DockPanel.Dock="Right" FontSize="12"/>
                    </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="الاشتراك :" Foreground="{DynamicResource Brush.Primary}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="{Binding SportName}" Margin="2 0" DockPanel.Dock="Right" FontSize="12"/>
                    </StackPanel>

                       

                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="سعر الاشتراك :" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" FontSize="12"/>
                            <TextBlock Text="{Binding PriceAfterOffer}" Margin="2 0" DockPanel.Dock="Right" FontSize="12"/>
                    </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="تاريخ الاشتراك :" Foreground="{DynamicResource Brush.Primary}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="{Binding RollDate}" Margin="2 0" DockPanel.Dock="Right" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="تاريخ نهاية الاشتراك :" Foreground="{DynamicResource Brush.Primary}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="{Binding EndDate}" Margin="2 0" DockPanel.Dock="Right" FontSize="12"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="2">

                    <Image Source="/Resources/Assets/logo.png" Width="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5" Grid.Column="1">
                        <TextBlock Text="تمت طباعة هذا الوصل بواسطة برنامج يونيسيبس لادارة الاندية الرياضية " FontSize="10" VerticalAlignment="Center"  Foreground="#000"/>
                        <TextBlock Text="UNICEPS جميع الحقوق محفوظة" FontSize="8" VerticalAlignment="Center"  Foreground="#000"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <Line X1="0" Y1="0" 
          X2="0" Y2="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" 
          Stroke="Gray" 
          StrokeThickness="2" 
          StrokeDashArray="4 2" 
          Opacity="0.5" 
          VerticalAlignment="Stretch" 
          HorizontalAlignment="Left" 
          Stretch="Fill"/>
            </Grid>
            <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding GymName}" FontSize="18" FontWeight="Bold" Grid.Row="0" HorizontalAlignment="Center" Foreground="#0078D7" VerticalAlignment="Center"/>
                <Image Source="{Binding QRCodeImage}" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Code}" FontSize="18"  HorizontalAlignment="Center" Grid.Row="2"  Margin="0,0,0,0"/>
                <TextBlock Text="يمكنك استخدام الكود المرفق لتسهيل عملية الدخول اليومي" FontSize="12" Grid.Row="3" HorizontalAlignment="Center"/>
            </Grid>

        </Grid>
    </Border>
</UserControl>
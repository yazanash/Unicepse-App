<UserControl x:Class="Uniceps.utlis.Pages.SubscriptionPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Width="185"  
             Background="White"
             HorizontalAlignment="Left"
             Padding="0" Margin="0"
       >
    <StackPanel Margin="0" HorizontalAlignment="Center">
        <!-- الهيدر: اللوجو واسم النادي -->
        <Image Source="{Binding GymLogo}" Width="50" Height="50" HorizontalAlignment="Center" Margin="0,0,0,5" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="{Binding GymName}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#0078D7"/>
        <TextBlock Text="{Binding GymPhone}" FontSize="11" HorizontalAlignment="Center" />

        <Separator Background="Black" Margin="0,5"/>

        <!-- تفاصيل الاشتراك: تحت بعضها لأن العرض لا يسمح بجانب بعض -->
        <StackPanel Orientation="Horizontal" Margin="0,3">
            <TextBlock Text="اسم اللاعب: " FontWeight="Bold" FontSize="11"/>
            <TextBlock Text="{Binding PlayerName}" FontSize="11"/>
        </StackPanel>

        <!-- سطر الاشتراك -->
        <StackPanel Orientation="Horizontal" Margin="0,3">
            <TextBlock Text="الاشتراك: " FontWeight="Bold" FontSize="11"/>
            <TextBlock Text="{Binding SportName}" FontSize="11"/>
        </StackPanel>

        <!-- سطر المدرب -->
        <StackPanel Orientation="Horizontal" Margin="0,3">
            <TextBlock Text="مع المدرب: " FontWeight="Bold" FontSize="11"/>
            <TextBlock Text="{Binding Trainer}" FontSize="11"/>
        </StackPanel>

        <!-- سطر السعر -->
        <StackPanel Orientation="Horizontal" Margin="0,3">
            <TextBlock Text="السعر: " FontWeight="Bold" FontSize="11"/>
            <TextBlock Text="{Binding PriceAfterOffer}" FontSize="11"/>
        </StackPanel>

        <!-- سطر تاريخ البدء -->
        <StackPanel Orientation="Horizontal" Margin="0,3">
            <TextBlock Text="تاريخ البدء: " FontWeight="Bold" FontSize="11"/>
            <TextBlock Text="{Binding RollDate}" FontSize="11"/>
        </StackPanel>

        <!-- سطر تاريخ الانتهاء -->
        <StackPanel Orientation="Horizontal" Margin="0,3">
            <TextBlock Text="تاريخ الانتهاء: " FontWeight="Bold" FontSize="11"/>
            <TextBlock Text="{Binding EndDate}" FontSize="11"/>
        </StackPanel>

        <Separator Background="Black" Margin="0,5"/>

        <TextBlock Text="كود الدخول السريع" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
        <Image Source="{Binding QRCodeImage}" Width="150" Height="150" HorizontalAlignment="Center" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="{Binding Code}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>

        <Separator Background="Black" Margin="0,5"/>

        <TextBlock Text="تمت الطباعة بواسطة برنامج يونيسيبس" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock Text="شكراً لزيارتكم" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,10"/>

        <TextBlock Text=" " Height="20"/>
    </StackPanel>
</UserControl>
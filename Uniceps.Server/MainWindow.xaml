<Window x:Class="Uniceps.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Uniceps.Server"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
         xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- الهيدر بطاقات الحالة -->
            <RowDefinition Height="*"/>
            <!-- سجل الطلبات الحية -->
        </Grid.RowDefinitions>
        <tb:TaskbarIcon IconSource="/uni_luncher.ico"
                        ToolTipText="Uniceps Server is Running">

            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="فتح الواجهة" Click="Open_Click"/>
                    <Separator/>
                    <MenuItem Header="خروج نهائي" Click="Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: الحالة -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,5,0" Padding="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="حالة السيرفر" Foreground="Gray" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#2ECC71" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="شغال (Running)" FontWeight="Bold" Foreground="#2C3E50"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: العنوان والبورت -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="5,0,5,0" Padding="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="عنوان الاتصال (URL)" Foreground="Gray" FontSize="12"/>
                    <TextBlock x:Name="TxtServerIp" Text="http://...:9000" FontWeight="Bold" Foreground="#2980B9" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: مدة التشغيل -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Margin="5,0,0,0" Padding="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="مدة التشغيل (Uptime)" Foreground="Gray" FontSize="12"/>
                    <TextBlock x:Name="TxtUptime" Text="00:00:00" FontWeight="Bold" Foreground="#8E44AD" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. منطقة سجل الأحداث والطلبات الحية (Live Logs) -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--<DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="سجل طلبات الشبكة (Live Request Logs)" FontWeight="Bold" Foreground="#34495E"/>
                    <Button Content="تفريغ السجل" HorizontalAlignment="Right" Click="ClearLogs_Click" Padding="8,2" Background="#ECF0F1" BorderThickness="0"/>
                </DockPanel>

                <ListBox x:Name="LstLogs" Grid.Row="1" FontFamily="Consolas" FontSize="12" Background="#FAFAFA" BorderBrush="#E0E0E0"/>-->
            </Grid>
        </Border>
    </Grid>
</Window>
